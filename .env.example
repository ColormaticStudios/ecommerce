# Read wiki/Configuration.md for information

DATABASE_URL="postgresql://ecommerce:123@localhost:5432/ecommerce"
AUTO_APPLY_MIGRATIONS="false"
PORT="3000"
JWT_SECRET=""
DISABLE_LOCAL_SIGN_IN="false"
DEV_MODE="true"
PUBLIC_URL="api.example.com"
MEDIA_ROOT="media"
MEDIA_PUBLIC_URL="http://localhost:3000/media"
SERVE_MEDIA="true"
CHECKOUT_PLUGIN_MANIFESTS_DIR=""
PROVIDER_PLUGIN_MANIFESTS_DIR=""
PROVIDER_RUNTIME_ENVIRONMENT="sandbox"
PROVIDER_CREDENTIALS_KEYS=""
PROVIDER_CREDENTIALS_ACTIVE_KEY_VERSION=""
PROVIDER_RECONCILIATION_INTERVAL=""
CMS_INVALIDATION_WEBHOOK_URL=""
TELEMETRY_ENABLED="true"
TELEMETRY_BIND_ADDRESS="127.0.0.1:9090"
METRICS_PATH="/metrics"
TRACING_ENABLED="false"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://127.0.0.1:4318/v1/traces"
TRACE_SAMPLE_RATIO="0.1"
TRUST_REQUEST_IDS="false"
# Comma-separated addresses/ranges of proxies allowed to supply client IP headers.
# Co-hosted SvelteKit SSR peer; use its actual narrow address if hosted separately.
TRUSTED_PROXY_CIDRS="127.0.0.1/32,::1/128"
ALERT_OWNER=""
ALERT_SERVICE="ecommerce-api"
DEPLOYMENT_ENVIRONMENT="development"
RELEASE_ID="development"
JOB_WORKER_CONCURRENCY="4"
JOB_POLL_INTERVAL="1s"
JOB_LEASE_DURATION="2m"
JOB_MAX_ATTEMPTS="5"
JOB_RETRY_BASE_DELAY="5s"
JOB_RETRY_MAX_DELAY="15m"

# Search admission, timeout, circuit recovery, and full-reindex queue limits.
SEARCH_MAX_CONCURRENT=50
SEARCH_CLIENT_MAX_CONCURRENT=4
SEARCH_CLIENT_REQUESTS_PER_MINUTE=120
SEARCH_IMPRESSION_MAX_CONCURRENT=8
SEARCH_IMPRESSION_REQUESTS_PER_MINUTE=600
SEARCH_CLIENT_IMPRESSIONS_PER_MINUTE=20
SEARCH_TIMEOUT_MS=2000
SEARCH_CIRCUIT_FAILURE_THRESHOLD=5
SEARCH_CIRCUIT_OPEN_MS=30000
SEARCH_REINDEX_QUEUE_LIMIT=1
