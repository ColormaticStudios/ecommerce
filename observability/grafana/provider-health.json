{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [{ "title": "Provider runbook", "type": "link", "url": "https://git.colormatic.org/ColormaticStudios/ecommerce/wiki/Observability-Runbooks#ecommerceproviderfailurestorm" }],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum by (provider_type) (rate(ecommerce_provider_calls_total{deployment_environment=\"$environment\",outcome=\"failed\"}[5m])) / clamp_min(sum by (provider_type) (rate(ecommerce_provider_calls_total{deployment_environment=\"$environment\"}[5m])), 0.001)", "legendFormat": "{{provider_type}}", "refId": "A" }],
      "title": "Provider failure ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, provider_type, operation) (rate(ecommerce_provider_call_duration_seconds_bucket{deployment_environment=\"$environment\"}[5m])))", "legendFormat": "{{provider_type}} / {{operation}}", "refId": "A" }],
      "title": "Provider call p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "targets": [{ "expr": "sum by (provider_type, operation, outcome) (rate(ecommerce_provider_calls_total{deployment_environment=\"$environment\"}[5m]))", "legendFormat": "{{provider_type}} / {{operation}} / {{outcome}}", "refId": "A" }],
      "title": "Provider call outcomes",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ecommerce", "reliability", "providers"],
  "templating": { "list": [
    { "current": {}, "hide": 0, "label": "Prometheus", "name": "datasource", "query": "prometheus", "type": "datasource" },
    { "current": {}, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "definition": "label_values(ecommerce_provider_calls_total, deployment_environment)", "includeAll": false, "label": "Environment", "name": "environment", "query": { "query": "label_values(ecommerce_provider_calls_total, deployment_environment)", "refId": "PrometheusVariableQueryEditor-VariableQuery" }, "refresh": 1, "type": "query" }
  ] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Ecommerce Provider Health",
  "uid": "ecommerce-provider-health",
  "version": 1
}
