{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "API runbooks", "type": "link", "url": "https://git.colormatic.org/ColormaticStudios/ecommerce/wiki/Observability-Runbooks" }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "decimals": 3, "max": 1, "min": 0, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "1 - (sum(rate(ecommerce_http_requests_total{status_class=\"5xx\",deployment_environment=\"$environment\"}[5m])) / clamp_min(sum(rate(ecommerce_http_requests_total{deployment_environment=\"$environment\"}[5m])), 0.001))", "legendFormat": "availability", "refId": "A" }],
      "title": "5m API availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "sum by (status_class) (rate(ecommerce_http_requests_total{deployment_environment=\"$environment\"}[5m]))", "legendFormat": "{{status_class}}", "refId": "A" }],
      "title": "Request rate by status class",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, route) (rate(ecommerce_http_request_duration_seconds_bucket{deployment_environment=\"$environment\"}[5m])))", "legendFormat": "{{route}}", "refId": "A" }],
      "title": "p95 latency by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [{ "expr": "up{job=\"ecommerce-api\",deployment_environment=\"$environment\"}", "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "Scrape target health",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ecommerce", "reliability", "api"],
  "templating": {
    "list": [
      { "current": {}, "hide": 0, "label": "Prometheus", "name": "datasource", "query": "prometheus", "type": "datasource" },
      { "current": {}, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "definition": "label_values(ecommerce_http_requests_total, deployment_environment)", "includeAll": false, "label": "Environment", "name": "environment", "query": { "query": "label_values(ecommerce_http_requests_total, deployment_environment)", "refId": "PrometheusVariableQueryEditor-VariableQuery" }, "refresh": 1, "type": "query" }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Ecommerce API Health",
  "uid": "ecommerce-api-health",
  "version": 1
}
